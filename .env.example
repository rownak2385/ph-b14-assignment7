# Application (generate a high-entropy secret with at least 32 characters)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Neon PostgreSQL (use the pooled connection string supplied by Neon)
DATABASE_URL=postgresql://username:password@host.neon.tech/bazardor?sslmode=require

# OAuth providers (local callback URLs end in /api/auth/callback/google or github)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

